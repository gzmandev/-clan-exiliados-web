@model IntegranteCE
@{
    ViewData["Title"] = $"Credencial Digital {Model.CodigoCE}";
    var modo = ViewData["ModoCredencial"]?.ToString() ?? "completa";
    var deptoPrincipal = Model.Departamentos.FirstOrDefault() ?? "Operaciones";
    var unidadPrincipal = Model.Unidades.FirstOrDefault() ?? "UE-001";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2 no-print">
    <div>
        <h2 class="titulo-negocio mb-0 d-flex align-items-center">
            <i data-lucide="credit-card" class="me-2" style="color: var(--color-primary); width: 26px; height: 26px;"></i>
            <span>Credencial Digital Institucional — <span class="hud-mono">@Model.CodigoCE</span></span>
        </h2>
        <p class="text-muted mb-0 small">Documento identificatorio ficticio de Clan Exiliados para actividades MILSIM y Roleplay.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Credencial" asp-route-id="@Model.CodigoCE" asp-route-modo="completa"
           class="btn btn-sm @(modo == "completa" ? "btn-hud-primary" : "btn-hud-outline")">Vista Completa</a>
        <a asp-action="Credencial" asp-route-id="@Model.CodigoCE" asp-route-modo="compacta"
           class="btn btn-sm @(modo == "compacta" ? "btn-hud-primary" : "btn-hud-outline")">Vista Compacta</a>
        <button type="button" class="btn btn-sm btn-hud-outline d-inline-flex align-items-center" onclick="window.print();">
            <i data-lucide="printer" class="me-1"></i>
            <span>Imprimir / Guardar PDF</span>
        </button>
        <button type="button" class="btn btn-sm btn-hud-outline d-inline-flex align-items-center"
                onclick="descargarCredencialPNG('@Model.CodigoCE','@Model.Alias','@Model.Nombre','@Model.Rango','@deptoPrincipal','@unidadPrincipal','@Model.FechaIngreso.ToString("dd/MM/yyyy")','@Model.EstadoInstitucional');">
            <i data-lucide="download" class="me-1"></i>
            <span>Exportar Imagen PNG</span>
        </button>
        <a asp-action="Expediente" asp-route-id="@Model.CodigoCE" class="btn btn-sm btn-hud-outline d-inline-flex align-items-center">
            <i data-lucide="arrow-left" class="me-1"></i>
            <span>Expediente</span>
        </a>
    </div>
</div>

@if (modo == "compacta")
{
    <!-- VISTA COMPACTA (TARJETA DE BOLSILLO HUD) -->
    <div class="hud-panel p-4 mx-auto" style="max-width: 440px; background: var(--bg-card); border: 1px solid var(--border-dark); border-radius: 4px;">
        <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3" style="border-color: var(--border-dark) !important;">
            <div class="d-flex align-items-center gap-2">
                <div class="ce-shield-badge" style="width: 38px; height: 38px; font-size: 1.1rem; border-color: var(--color-primary); color: var(--color-primary); background: var(--bg-main);">CE</div>
                <div>
                    <div class="fw-bold" style="font-family: var(--font-display); color: var(--text-primary); letter-spacing: 1px;">CLAN EXILIADOS</div>
                    <small style="color: var(--color-primary); font-size: 0.72rem; letter-spacing: 0.5px;">PASE TÁCTICO COMPACTO</small>
                </div>
            </div>
            <span class="badge hud-mono" style="background: var(--bg-main); border: 1px solid var(--color-primary); color: var(--color-primary);">@Model.CodigoCE</span>
        </div>
        <h4 class="fw-bold mb-0" style="font-family: var(--font-display); color: var(--color-alert);">@Model.Alias</h4>
        <div class="small text-muted mb-2">@Model.Nombre</div>
        <div class="row g-2 small mb-2" style="color: var(--text-primary);">
            <div class="col-6"><strong class="text-muted">Rango:</strong> @Model.Rango</div>
            <div class="col-6"><strong class="text-muted">Estado:</strong> @Model.EstadoInstitucional</div>
            <div class="col-6"><strong class="text-muted">Depto.:</strong> @deptoPrincipal</div>
            <div class="col-6"><strong class="text-muted">Unidad:</strong> @unidadPrincipal</div>
        </div>
        <div class="text-muted border-top pt-2" style="border-color: var(--border-dark) !important; font-size: 0.72rem;">
            Ingreso: <span class="hud-mono">@Model.FechaIngreso.ToString("dd/MM/yyyy")</span> · Credencial ficticia de videojuego sin validez legal.
        </div>
    </div>
}
else
{
    <!-- VISTA COMPLETA OFICIAL -->
    <div class="hud-panel p-4 mx-auto" style="max-width: 740px; background: var(--bg-card); border: 1px solid var(--border-dark); border-radius: 4px;">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom pb-3 mb-4 gap-2" style="border-color: var(--border-dark) !important;">
            <div class="d-flex align-items-center gap-3">
                <div class="ce-shield-badge" style="width: 54px; height: 54px; font-size: 1.5rem; border-color: var(--color-primary); color: var(--color-primary); background: var(--bg-main);">CE</div>
                <div>
                    <h3 class="fw-bold mb-0" style="font-family: var(--font-display); color: var(--text-primary); letter-spacing: 1px;">CLAN EXILIADOS — CREDENCIAL INSTITUCIONAL</h3>
                    <div class="small fw-semibold" style="color: var(--color-primary); font-family: var(--font-display); letter-spacing: 0.5px;">COMUNIDAD TÁCTICA DE SIMULACIÓN MILSIM Y ROLEPLAY</div>
                </div>
            </div>
            <div class="text-sm-end">
                <span class="badge hud-mono fs-6 px-3 py-2" style="background: var(--bg-main); border: 1px solid var(--color-primary); color: var(--color-primary);">@Model.CodigoCE</span>
                <div class="small text-muted mt-1">Estado: <strong style="color: var(--text-primary);">@Model.EstadoInstitucional.ToUpper()</strong></div>
            </div>
        </div>

        <div class="row g-4 align-items-center">
            <div class="col-12 col-md-8">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase">Nombre de Expediente</div>
                        <div class="fw-bold fs-6" style="color: var(--text-primary);">@Model.Nombre</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase">Alias / Indicativo Táctico</div>
                        <div class="fw-bold fs-5" style="color: var(--color-alert); font-family: var(--font-display);">@Model.Alias</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase">Rango Institucional</div>
                        <div class="fw-bold" style="color: var(--color-primary);">@Model.Rango</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase">Facción Oficial</div>
                        <div><span class="badge @(Model.Faccion == "Militares" ? "badge-militares" : (Model.Faccion == "Mercenarios" ? "badge-mercenarios" : "badge-terroristas"))">@Model.Faccion</span></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase">Departamento Principal</div>
                        <div class="fw-semibold" style="color: var(--text-primary);">@string.Join(", ", Model.Departamentos)</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase">Unidad Asignada</div>
                        <div class="fw-semibold" style="color: var(--text-primary);">@string.Join(", ", Model.Unidades)</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase">Fecha de Incorporación</div>
                        <div class="hud-mono" style="color: var(--text-primary);">@Model.FechaIngreso.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small text-uppercase">Discord Verificado</div>
                        <div><code class="hud-mono">@Model.Discord</code></div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4 text-center">
                <div class="p-3 rounded" style="background: var(--bg-elevated); border: 1px solid var(--border-dark);">
                    <div class="fw-bold mb-2" style="font-family: var(--font-display); color: var(--color-alert); font-size: 0.85rem; letter-spacing: 1px;">INSIGNIA DE RANGO</div>
                    <div class="mb-2 d-flex justify-content-center">
                        <i data-lucide="shield" style="width: 48px; height: 48px; color: var(--color-primary); stroke-width: 1.8;"></i>
                    </div>
                    <div class="fw-bold" style="color: var(--text-primary); font-family: var(--font-display);">@Model.Rango</div>
                    <div class="small hud-mono text-muted">@Model.HorasMilsim.ToString("N0") h MILSIM</div>
                </div>
            </div>
        </div>

        <div class="border-top mt-4 pt-3 d-flex flex-column flex-sm-row justify-content-between small text-muted" style="border-color: var(--border-dark) !important;">
            <span class="d-inline-flex align-items-center">
                <i data-lucide="alert-triangle" class="me-1" style="width: 14px; height: 14px; color: var(--color-alert);"></i>
                Credencial digital ficticia de uso exclusivo en videojuegos (Arma 3 · Reforger · FiveM). Sin validez oficial ni legal.
            </span>
            <span class="fw-bold hud-mono" style="color: var(--color-primary);">AUTENTICADO POR COMANDO CE</span>
        </div>
    </div>
}
