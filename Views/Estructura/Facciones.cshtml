@model ClanExiliados_Web.Services.ClanInstitutionalService
@{
    ViewData["Title"] = "Facciones Oficiales";
    var facciones = new[]
    {
        new
        {
            Nombre = "Militares",
            Icono = "shield",
            Clase = "badge-militares",
            Borde = "var(--color-primary)"
        },
        new
        {
            Nombre = "Mercenarios",
            Icono = "crosshair",
            Clase = "badge-mercenarios",
            Borde = "var(--color-amber)"
        },
        new
        {
            Nombre = "Terroristas",
            Icono = "flame",
            Clase = "badge-terroristas",
            Borde = "var(--color-danger)"
        }
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="hud-title mb-1">Facciones Oficiales</h2>
        <p class="text-secondary mb-0 small">
            Facciones reconocidas en Clan Exiliados para la asignación y registro de integrantes.
        </p>
    </div>
</div>

<div class="row g-4">
    @foreach (var f in facciones)
    {
        var miembros = Model.Integrantes.Where(i => i.Faccion.Equals(f.Nombre, StringComparison.OrdinalIgnoreCase)).ToList();
        <div class="col-xl-4 col-md-6">
            <div class="hud-panel p-4 h-100 d-flex flex-column justify-content-between" style="border-top: 3px solid @f.Borde;">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 rounded" style="background: var(--color-bg-elevated); border: 1px solid var(--color-border);">
                                <i data-lucide="@f.Icono" style="color: @f.Borde;"></i>
                            </div>
                            <h4 class="hud-title mb-0 text-light">@f.Nombre</h4>
                        </div>
                        <span class="hud-badge @f.Clase hud-mono">@miembros.Count INTEGRANTES</span>
                    </div>
                </div>

                <div class="pt-3 border-top border-secondary">
                    <div class="hud-mono small text-muted mb-2">INTEGRANTES ASIGNADOS:</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var m in miembros)
                        {
                            <a asp-controller="Personal" asp-action="Expediente" asp-route-id="@m.CodigoCE"
                               class="badge text-decoration-none py-1 px-2"
                               style="background: var(--color-bg-elevated); color: var(--color-text-main); border: 1px solid var(--color-border);">
                                <span class="hud-mono text-primary">@m.CodigoCE</span> @m.Alias
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
