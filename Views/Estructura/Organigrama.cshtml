@model ClanExiliados_Web.Services.ClanInstitutionalService
@{
    ViewData["Title"] = "Organigrama Institucional Interactivo";
    var perspectiva = (ViewData["Perspectiva"]?.ToString() ?? "jerarquica").ToLowerInvariant();
    var filtroRango = ViewData["FiltroRango"]?.ToString() ?? "";
    var filtroDepartamento = ViewData["FiltroDepartamento"]?.ToString() ?? "";
    var filtroUnidad = ViewData["FiltroUnidad"]?.ToString() ?? "";

    var integrantesFiltrados = Model.Integrantes.AsEnumerable();
    if (!string.IsNullOrEmpty(filtroRango))
        integrantesFiltrados = integrantesFiltrados.Where(i => i.Rango.Equals(filtroRango, StringComparison.OrdinalIgnoreCase));
    if (!string.IsNullOrEmpty(filtroDepartamento))
        integrantesFiltrados = integrantesFiltrados.Where(i => i.Departamentos.Any(d => d.Equals(filtroDepartamento, StringComparison.OrdinalIgnoreCase)));
    if (!string.IsNullOrEmpty(filtroUnidad))
        integrantesFiltrados = integrantesFiltrados.Where(i => i.Unidades.Any(u => u.Equals(filtroUnidad, StringComparison.OrdinalIgnoreCase)));

    var listaUnica = integrantesFiltrados.ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="hud-kicker">MÓDULO 20 · VISUALIZACIÓN JERÁRQUICA Y ORGANIZATIVA SIN DUPLICIDAD</div>
        <h2 class="hud-title mb-1">Organigrama Institucional Interactivo</h2>
        <p class="text-secondary mb-0 small">
            Cada integrante aparece una única vez por vista mediante su nodo principal (<span class="hud-mono text-success">CE-###</span>), evitando duplicación visual cuando pertenece a varios departamentos o unidades.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Organigrama" asp-route-perspectiva="jerarquica"
           class="btn btn-sm @(perspectiva == "jerarquica" ? "btn-hud-primary" : "btn-hud-outline")">
            Perspectiva Jerárquica (Dirección → Mando → Integrantes)
        </a>
        <a asp-action="Organigrama" asp-route-perspectiva="organizativa"
           class="btn btn-sm @(perspectiva == "organizativa" ? "btn-hud-primary" : "btn-hud-outline")">
            Perspectiva Organizativa (Comando → Deptos. → Unidades)
        </a>
    </div>
</div>

<!-- BARRA DE FILTROS DEL ORGANIGRAMA -->
<form method="get" asp-action="Organigrama" class="hud-panel p-3 mb-4">
    <input type="hidden" name="perspectiva" value="@perspectiva" />
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small hud-mono">FILTRAR POR RANGO</label>
            <select name="rango" class="form-select form-select-sm hud-input">
                <option value="">Todos los rangos (8)</option>
                @foreach (var r in Model.Rangos.OrderBy(x => x.Orden))
                {
                    <option value="@r.Nombre" selected="@(filtroRango == r.Nombre)">@r.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small hud-mono">FILTRAR POR DEPARTAMENTO</label>
            <select name="departamento" class="form-select form-select-sm hud-input">
                <option value="">Todos los departamentos (5)</option>
                @foreach (var d in Model.Departamentos)
                {
                    <option value="@d.Nombre" selected="@(filtroDepartamento == d.Nombre)">@d.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small hud-mono">FILTRAR POR UNIDAD TÁCTICA</label>
            <select name="unidad" class="form-select form-select-sm hud-input">
                <option value="">Todas las unidades (UE-001..UE-005)</option>
                @foreach (var u in Model.Unidades)
                {
                    <option value="@u.Id" selected="@(filtroUnidad == u.Id)">@u.Id · @u.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-hud-primary btn-sm flex-grow-1">Aplicar Filtros</button>
            <a asp-action="Organigrama" asp-route-perspectiva="@perspectiva" class="btn btn-hud-outline btn-sm">Limpiar</a>
        </div>
    </div>
</form>

@if (perspectiva == "jerarquica")
{
    var niveles = new[]
    {
        new { Titulo = "NIVEL I · ALTA DIRECCIÓN INSTITUCIONAL", Sub = "Cúpula estratégica y fundacional", Rangos = new[] { "Director/Fundador", "Comandante" }, Color = "#C5A059" },
        new { Titulo = "NIVEL II · OFICIALES DE MANDO Y DIRECCIÓN", Sub = "Capitanes y Tenientes de unidad y departamento", Rangos = new[] { "Capitán", "Teniente" }, Color = "#4ADE80" },
        new { Titulo = "NIVEL III · SUBOFICIALES RESPONSABLES DE ESCUADRA", Sub = "Sargentos y Cabos tácticos", Rangos = new[] { "Sargento", "Cabo" }, Color = "#38BDF8" },
        new { Titulo = "NIVEL IV · CUERPO OPERATIVO E INGRESO", Sub = "Operadores certificados y Reclutas en instrucción", Rangos = new[] { "Operador", "Recluta" }, Color = "#94A3B8" }
    };

    <div class="d-flex flex-column gap-4">
        @foreach (var niv in niveles)
        {
            var miembrosNivel = listaUnica.Where(i => niv.Rangos.Contains(i.Rango)).ToList();
            <div class="hud-panel p-4" style="border-left: 4px solid @niv.Color;">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                    <div>
                        <div class="hud-mono small" style="color:@niv.Color;">@niv.Titulo</div>
                        <div class="small text-secondary">@niv.Sub</div>
                    </div>
                    <span class="hud-badge hud-badge-neutral">@miembrosNivel.Count NODO(S)</span>
                </div>

                <div class="row g-3">
                    @foreach (var m in miembrosNivel)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="p-3 rounded h-100" style="background: rgba(16,23,20,0.9); border: 1px solid rgba(255,255,255,0.08);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="hud-mono fw-bold text-success">@m.CodigoCE</span>
                                    <span class="hud-badge @(m.Disponibilidad == "Disponible" ? "hud-badge-success" : "hud-badge-warning")">@m.Disponibilidad</span>
                                </div>
                                <div class="fw-bold text-light fs-6">@m.Alias</div>
                                <div class="small text-warning hud-mono mb-2">@m.Rango · @m.Faccion</div>
                                <div class="small text-secondary mb-1">
                                    Depto. Principal: <strong class="text-light">@(m.Departamentos.FirstOrDefault() ?? "Operaciones")</strong>
                                </div>
                                <div class="small text-secondary mb-3">
                                    Unidad Principal: <strong class="hud-mono text-info">@(m.Unidades.FirstOrDefault() ?? "UE-001")</strong>
                                    @if (m.Unidades.Count > 1)
                                    {
                                        <span class="text-secondary">(+@(m.Unidades.Count - 1) adicional)</span>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-hud-outline btn-sm flex-grow-1"
                                            onclick="abrirVistaPreviaIntegrante('@m.CodigoCE', '@m.Alias', '@m.Nombre', '@m.Rango', '@m.Faccion', '@string.Join(", ", m.Departamentos)', '@string.Join(", ", m.Unidades)', '@m.HorasMilsim', '@m.EstadoInstitucional', '@m.Disponibilidad', '@m.Discord')">
                                        Vista Previa
                                    </button>
                                    <a asp-controller="Personal" asp-action="Expediente" asp-route-id="@m.CodigoCE" class="btn btn-hud-primary btn-sm">
                                        Ficha
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- PERSPECTIVA ORGANIZATIVA SIN DUPLICAR INTEGRANTES (CADA INTEGRANTE SE UBICA EN SU UNIDAD PRINCIPAL) -->
    var asignados = new HashSet<string>();
    <div class="row g-4">
        @foreach (var u in Model.Unidades)
        {
            var miembrosUnicosUnidad = listaUnica
                .Where(i => (i.Unidades.FirstOrDefault() ?? "UE-001").Equals(u.Id, StringComparison.OrdinalIgnoreCase) && !asignados.Contains(i.CodigoCE))
                .ToList();
            foreach (var mu in miembrosUnicosUnidad)
            {
                asignados.Add(mu.CodigoCE);
            }

            <div class="col-xl-6">
                <div class="hud-panel p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="hud-mono fw-bold text-success">@u.Id · @u.Nombre</span>
                        <span class="hud-badge hud-badge-info">DEPTO: @u.DepartamentoAsociado</span>
                    </div>
                    <div class="small text-secondary mb-3">Mando de Unidad: <strong class="text-warning">@u.Lider</strong></div>

                    <div class="row g-2">
                        @foreach (var m in miembrosUnicosUnidad)
                        {
                            <div class="col-sm-6">
                                <div class="p-2 rounded d-flex justify-content-between align-items-center"
                                     style="background: rgba(16,23,20,0.88); border: 1px solid rgba(255,255,255,0.08);">
                                    <div>
                                        <div class="hud-mono small text-success fw-bold">@m.CodigoCE · @m.Alias</div>
                                        <div class="small text-secondary">@m.Rango · @string.Join(", ", m.Especialidades)</div>
                                    </div>
                                    <a asp-controller="Personal" asp-action="Expediente" asp-route-id="@m.CodigoCE" class="btn btn-hud-outline btn-sm py-0 px-2">
                                        Ver
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
